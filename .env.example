APP_NAME=Runovia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Runovia API — required
# ---------------------------------------------------------------------------
#
# This app has no database of its own; the API holds every domain record and owns
# every business rule. Mint the client credentials on the API side with:
#
#   php database/create-app-client.php --name="Runovia Web" --app=RV --client=web
#
# The secret is printed once and is not recoverable. RUNOVIA_API_CLIENT must match
# the --client it was registered for, or auth gate 7 answers 403 / code 110.
RUNOVIA_API_URL=http://localhost:8000
RUNOVIA_API_CLIENT=web
RUNOVIA_API_CLIENT_ID=
RUNOVIA_API_CLIENT_SECRET=
RUNOVIA_API_TIMEOUT=15

# ---------------------------------------------------------------------------
# Local state — file-based on purpose. A front end for a remote API has no
# reason to run a database.
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@runovia.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
